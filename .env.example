# AWM Relationship OS Kit — Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot
TELEGRAM_BOT_TOKEN=
AUTHORIZED_USER_ID=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# Relationship OS Store
# Product rule: keep the agent's structured source of truth in SQLite.
# Legacy value: RELATIONSHIP_OS_STORE=google is deprecated — use sqlite as the
# store and set RELATIONSHIP_OS_CONSULTANT_VIEW=google to surface a Google
# Sheets view from SQLite.
RELATIONSHIP_OS_STORE=sqlite
RELATIONSHIP_OS_DB_PATH=./data/relationship_os.sqlite3

# Consultant-facing view
# Use csv for local testing, google for Google Sheets, or obsidian for Markdown.
RELATIONSHIP_OS_CONSULTANT_VIEW=csv
RELATIONSHIP_OS_LOCAL_DIR=./data/local_sheet
RELATIONSHIP_OS_KIT_DIR=.
RELATIONSHIP_OS_VAULT_DIR=./vault
RELATIONSHIP_OS_DESIGN_PATH=./design.md
RELATIONSHIP_OS_DESIGN_SCHEME=awm-light
# Override only if you want to point the PDF/PPTX renderer at a different
# brand asset folder. Defaults to the kit's ./assets/ folder.
# RELATIONSHIP_OS_BRAND_ASSETS_DIR=./assets

# Consultant Info
CONSULTANT_NAME=
CONSULTANT_TIMEZONE=Asia/Singapore
